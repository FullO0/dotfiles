{
    // Layering setup
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    // Block Group Positioning
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/media"],
    "modules-right": ["cpu", "memory", "network", "clock"],

    // =====================================================================
    // CORE MODULE DEFINTIONS
    // =====================================================================
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "tooltip-format": "Used: {used:0.1f}G / Total: {total:0.1f}G"
    },

    "network": {
        "interface": "wlan0", 
        "format-wifi": " {essid}",
        "format-ethernet": "🖧 {ifname}",
        "format-disconnected": "⚠ Disconnected"
    },

    "custom/media": {
        "format": "󰎆 {}",
        "escape": true,
        "return-type": "json",
        "max-length": 40,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' --follow",
        "on-click": "playerctl play-pause"
    }
}
