[user]
	email = christian@vanderwalts.net
	name = Christian van der Walt

[core]
	editor = nvim
	excludesfile = ~/.config/git/gitignore_global

[init]
	defaultbranch = main

[submodule]
	recurse = true

[alias]
	a = add
	st = status
	co = checkout
	br = branch
	cm = commit -m
	lg = log --graph --oneline --decorate --all
	unstage = reset HEAD -

[color]
	ui = auto
[fetch]
	prune = true
