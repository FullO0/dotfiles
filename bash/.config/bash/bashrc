#!/bin/bash
# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

# Local script for machine dependent settings
touch "$HOME/.dotfiles/bash/.config/bash/local_script.sh"
. "$HOME/.dotfiles/bash/.config/bash/local_script.sh"

# Load API keys
touch "$HOME/.dotfiles/bash/.config/bash/api_keys.sh"
. "$HOME/.dotfiles/bash/.config/bash/api_keys.sh"

# ------ ENVIRMENT VARIABLES ------

# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Force tools to follow XDG standard
export GIT_CONFIG_GLOBAL="$XDG_CONFIG_HOME/git/config"
export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude"
export JUPYTER_CONFIG_DIR="$XDG_CONFIG_HOME/jupyter"
export JUPYTER_DATA_DIR="$XDG_DATA_HOME/jupyter"
export COPILOT_HOME="$XDG_CONFIG_HOME/copilot"
export OLLAMA_MODELS="$XDG_DATA_HOME/ollama"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NPM_CONFIG_CACHE="$XDG_STATE_HOME/npm"

# add .local/bin with highest priority
export PATH="$HOME/.local/bin:$PATH"

# Change history path to match XDG standards
export HISTFILE="$XDG_STATE_HOME/bash/history"

# LangSmith Settings
export LANGSMITH_TRACING=true

# Set default editor and visual
export EDITOR="nvim"
export VISUAL="nvim"

# ---------------------------------

# Ensure the directories actually exist
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
	test -r $XDG_CONFIG_HOME/bash/dircolors && eval "$(dircolors -b $XDG_CONFIG_HOME/bash/dircolors)" || eval "$(dircolors -b)"
	alias ls='ls --color=auto'
	alias dir='dir --color=auto'
	alias vdir='vdir --color=auto'

	alias grep='grep --color=auto'
	alias fgrep='fgrep --color=auto'
	alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# Alias definitions.
if [ -f "$XDG_CONFIG_HOME/bash/bash_aliases.sh" ]; then
	. "$XDG_CONFIG_HOME/bash/bash_aliases.sh"
fi

# Load Color enviroment variables
if [ -f "$XDG_CONFIG_HOME/bash/bash_color.sh" ]; then
	. "$XDG_CONFIG_HOME/bash/bash_color.sh"
fi

# Background color
if [[ $TERM != "linux" ]]; then
	printf "\e]11;%s\a" "$COLOR_BG0"
fi

# Enable starship
eval "$(starship init bash)"

if [ ! -n "$TMUX" ]; then
	echo ""
	echo ""
	fastfetch
fi
